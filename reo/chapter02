<script>
(() => {
  const root = document.documentElement;
  const progress = document.getElementById("progressBar");
  const themeSelect = document.getElementById("themeSelect");
  const fontBtn = document.getElementById("fontBtn");
  const sizeBtns = [...document.querySelectorAll("[data-size]")];
  const scenes = [...document.querySelectorAll(".scene")];
  const tocLinks = [...document.querySelectorAll(".toc a[href^='#scene-']")];
  const currentScene = document.getElementById("currentScene");
  const resumeCard = document.getElementById("resumeCard");
  const resumeBtn = document.getElementById("resumeBtn");
  const SETTINGS_KEY = "otome-reader-settings-v1";
  const POSITION_KEY = "otome_reo_02_not_your_brother_v2_position";

  function loadSettings(){
    try{
      const s = JSON.parse(localStorage.getItem(SETTINGS_KEY) || "{}");
      if(s.theme) root.dataset.theme = s.theme;
      if(s.font) root.dataset.font = s.font;
      if(s.size) root.dataset.size = s.size;
    }catch(e){}
    themeSelect.value = root.dataset.theme || "light";
    fontBtn.textContent = root.dataset.font === "sans" ? "ゴシック" : "明朝";
    sizeBtns.forEach(b => b.classList.toggle("active", b.dataset.size === root.dataset.size));
  }

  function saveSettings(){
    localStorage.setItem(SETTINGS_KEY, JSON.stringify({
      theme: root.dataset.theme,
      font: root.dataset.font,
      size: root.dataset.size
    }));
  }

  themeSelect.addEventListener("change", () => {
    root.dataset.theme = themeSelect.value;
    saveSettings();
  });

  fontBtn.addEventListener("click", () => {
    root.dataset.font = root.dataset.font === "sans" ? "serif" : "sans";
    fontBtn.textContent = root.dataset.font === "sans" ? "ゴシック" : "明朝";
    saveSettings();
  });

  sizeBtns.forEach(btn => btn.addEventListener("click", () => {
    root.dataset.size = btn.dataset.size;
    sizeBtns.forEach(b => b.classList.toggle("active", b === btn));
    saveSettings();
  }));

  function updateProgress(){
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? window.scrollY / max : 0;
    progress.style.width = `${Math.min(100, Math.max(0, ratio * 100))}%`;
  }

  let saveTimer;
  function savePosition(){
    clearTimeout(saveTimer);
    saveTimer = setTimeout(() => {
      try{ localStorage.setItem(POSITION_KEY, String(Math.round(window.scrollY))); }catch(e){}
    }, 120);
  }

  function offerResume(){
    let y = 0;
    try{ y = Number(localStorage.getItem(POSITION_KEY) || 0); }catch(e){}
    if(y > 420 && y < document.documentElement.scrollHeight - window.innerHeight - 180){
      resumeCard.classList.add("show");
      resumeBtn.addEventListener("click", () => {
        window.scrollTo({top:y, behavior:"smooth"});
        resumeCard.classList.remove("show");
      }, {once:true});
    }
  }

  const observer = new IntersectionObserver(entries => {
    const visible = entries
      .filter(e => e.isIntersecting)
      .sort((a,b) => b.intersectionRatio - a.intersectionRatio)[0];
    if(!visible) return;
    const id = visible.target.id;
    const number = id.replace("scene-","");
    currentScene.textContent = `SCENE ${number}`;
    tocLinks.forEach(a => a.classList.toggle("active", a.getAttribute("href") === `#${id}`));
  }, {rootMargin:"-25% 0px -60% 0px", threshold:[0,.2,.5]});

  scenes.forEach(scene => observer.observe(scene));
  window.addEventListener("scroll", () => { updateProgress(); savePosition(); }, {passive:true});
  window.addEventListener("resize", updateProgress);

  loadSettings();
  updateProgress();
  requestAnimationFrame(offerResume);
})();
</script>
