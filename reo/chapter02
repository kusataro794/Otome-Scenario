.reader-id{min-width:0}
.reader-kicker{display:block;color:var(--accent);font:900 10px var(--sans);letter-spacing:.15em}
.reader-title{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:600 12px var(--serif)}
