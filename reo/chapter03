<title>REO ROUTE 03｜DON’T LOOK AWAY ― もう、逸らさないで</title>
<style>
:root{
  --page:#f8f3f6;
  --surface:rgba(255,255,255,.95);
  --surface-soft:#f1e6ee;
  --text:#342b31;
  --text-soft:#72636d;
  --muted:#9d8d97;
  --line:#eadbe4;
  --accent:#8f5a78;
  --accent-deep:#69425b;
  --accent-soft:#ead5e2;
  --yui:#9b6b79;
  --reo:#824e6b;
  --shadow:0 18px 50px rgba(75,45,64,.09);
  --reader-width:700px;
  --font-size:17px;
  --leading:2.08;
  --serif:"Hiragino Mincho ProN","Yu Mincho","YuMincho","Noto Serif JP",serif;
  --sans:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic","Noto Sans JP",sans-serif;
}
html[data-theme="dark"]{
  --page:#171316;
  --surface:rgba(34,28,32,.96);
  --surface-soft:#2d232a;
  --text:#f4ebf0;
  --text-soft:#c8bac2;
  --muted:#978590;
  --line:#41323b;
  --accent:#d69cbb;
  --accent-deep:#efb8d5;
  --accent-soft:#493340;
  --yui:#d3a0ad;
  --reo:#de98bc;
  --shadow:0 18px 50px rgba(0,0,0,.28);
}
html[data-theme="sepia"]{
  --page:#f3ece2;
  --surface:rgba(253,249,243,.96);
  --surface-soft:#ece0d5;
  --text:#42362f;
  --text-soft:#75655d;
  --muted:#9a897e;
  --line:#dfcfc3;
  --accent:#895c68;
  --accent-deep:#694650;
  --accent-soft:#e5d0d0;
  --yui:#91675f;
  --reo:#805a69;
}
html[data-font="sans"]{--reader-font:var(--sans)}
html[data-font="serif"]{--reader-font:var(--serif)}
html[data-size="small"]{--font-size:15.5px}
html[data-size="medium"]{--font-size:17px}
html[data-size="large"]{--font-size:19px}

*{box-sizing:border-box}
html{scroll-behavior:smooth;background:var(--page)}
body{
  margin:0;min-height:100vh;color:var(--text);font-family:var(--sans);
  background:
    radial-gradient(circle at 10% 3%,rgba(151,82,120,.12),transparent 30rem),
    radial-gradient(circle at 92% 38%,rgba(113,65,91,.08),transparent 28rem),
    var(--page);
  -webkit-font-smoothing:antialiased;
}
a{color:inherit}
button,select{font:inherit}

.reading-progress{position:fixed;inset:0 0 auto 0;height:3px;z-index:1200}
.reading-progress span{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--accent),#c98cac)}

.reader-bar{
  position:sticky;top:0;z-index:1000;border-bottom:1px solid var(--line);
  background:color-mix(in srgb,var(--page) 91%,transparent);
  backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)
}
.reader-bar-inner{
  width:min(1120px,100%);min-height:64px;margin:auto;
  padding:max(8px,env(safe-area-inset-top)) 14px 8px;
  display:flex;align-items:center;justify-content:space-between;gap:12px
}
.reader-id{min-width:0}
.reader-kicker{display:block;color:var(--accent);font:900 10px var(--sans);letter-spacing:.15em}
.reader-title{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:600 12px var(--serif)}
.reader-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.tool-btn,.tool-select{
  min-height:38px;border:1px solid var(--line);border-radius:999px;color:var(--text);
  background:var(--surface);font:800 10px var(--sans);padding:0 10px
}
.tool-btn{min-width:38px;cursor:pointer}
.tool-btn.active{color:var(--accent);background:var(--surface-soft)}

.layout{
  width:min(1120px,100%);margin:auto;padding-top:24px;
  display:grid;grid-template-columns:220px minmax(0,810px);gap:30px;
  justify-content:center;align-items:start
}
.toc{
  position:sticky;top:86px;max-height:calc(100svh - 110px);overflow:auto;
  margin-left:16px;padding:14px;border:1px solid var(--line);
  border-radius:16px;background:var(--surface);box-shadow:var(--shadow)
}
.toc-label{margin:0 0 10px;color:var(--muted);font:900 10px var(--sans);letter-spacing:.16em}
.toc a{
  display:block;margin:3px 0;padding:8px 9px;border-radius:9px;color:var(--muted);
  text-decoration:none;font:500 12px/1.5 var(--sans)
}
.toc a:hover,.toc a.active{color:var(--accent);background:var(--surface-soft);font-weight:800}

.reader-shell{min-width:0}
.resume-card{display:none;width:min(100% - 36px,var(--reader-width));margin:0 auto 16px;padding:12px 14px;border:1px solid var(--line);border-radius:14px;background:var(--surface);color:var(--muted);font:12px/1.7 var(--sans)}
.resume-card.show{display:flex;align-items:center;justify-content:space-between;gap:12px}
.current-scene{
  display:none;width:min(100% - 36px,var(--reader-width));margin:0 auto 10px;
  color:var(--muted);font:800 10px var(--sans);letter-spacing:.08em
}
.page{width:min(100%,810px);margin:auto;padding:0 18px max(90px,env(safe-area-inset-bottom))}
.reader{
  width:min(100%,var(--reader-width));margin:auto;
  font-family:var(--reader-font,var(--serif));
  font-size:var(--font-size);line-height:var(--leading);letter-spacing:.025em
}

.hero{
  position:relative;overflow:hidden;margin:24px 0 32px;padding:62px 24px 50px;
  text-align:center;border:1px solid rgba(255,255,255,.55);border-radius:34px;
  background:linear-gradient(150deg,var(--surface),var(--surface-soft));box-shadow:var(--shadow)
}
.hero:before{
  content:"";position:absolute;width:260px;height:260px;top:-155px;right:-82px;
  border-radius:50%;background:color-mix(in srgb,var(--accent) 17%,transparent)
}
.hero:after{
  content:"";position:absolute;width:170px;height:170px;bottom:-105px;left:-85px;
  border-radius:50%;background:color-mix(in srgb,var(--accent-deep) 10%,transparent)
}
.hero>*{position:relative;z-index:1}
.eyebrow{margin:0 0 15px;color:var(--accent);font:900 10px var(--sans);letter-spacing:.22em}
.hero h1{margin:0;font:600 clamp(2.15rem,8vw,3.7rem)/1.3 var(--serif);letter-spacing:.07em}
.hero-sub{margin:9px 0 0;color:var(--accent-deep);font:600 1rem/1.7 var(--serif);letter-spacing:.08em}
.hero-copy{max-width:32rem;margin:30px auto 0;color:var(--text-soft);font-size:14px;line-height:2.1}
.route-lock{
  display:inline-flex;margin-top:24px;padding:7px 13px;border:1px solid var(--line);
  border-radius:999px;color:var(--accent-deep);background:var(--surface);
  font:900 9px var(--sans);letter-spacing:.13em
}
.reading-note{
  margin:0 0 44px;padding:14px 16px;border:1px solid var(--line);border-radius:15px;
  color:var(--text-soft);background:color-mix(in srgb,var(--surface-soft) 70%,transparent);
  font:11px/1.85 var(--sans)
}

.scene{padding-top:34px;margin-bottom:84px;scroll-margin-top:90px}
.scene-head{margin-bottom:39px;text-align:center}
.scene-no{display:block;color:var(--accent);font:900 10px var(--sans);letter-spacing:.22em}
.scene-head h2{margin:8px 0 0;font:600 1.26em/1.6 var(--serif);letter-spacing:.075em}
.scene-meta{margin-top:7px;color:var(--muted);font:700 10px var(--sans);letter-spacing:.08em}
.scene-rule{width:38px;height:1px;margin:18px auto 0;background:var(--line)}
.narration{margin:0 0 1.34em;text-align:justify;text-justify:inter-ideograph}
.dialogue{margin:2em 0 2.15em}
.speaker{display:flex;align-items:center;gap:8px;margin-bottom:.43em;font:900 .7em var(--sans);letter-spacing:.08em}
.speaker:before{content:"";width:18px;height:2px;border-radius:99px;background:currentColor;opacity:.55}
.dialogue.yui .speaker{color:var(--yui)}
.dialogue.reo .speaker{color:var(--reo)}
.line{margin:0;padding-left:1.35em;text-indent:-1.35em;font-weight:500}
.line+.line{margin-top:.45em}
.beat{display:grid;place-items:center;margin:55px 0;color:var(--muted);font-size:12px;letter-spacing:.55em}
.direction{margin:1.7em 0;color:var(--muted);text-align:center;font:.72em/1.8 var(--sans)}
.inner{
  margin:2.2em 0;padding:17px 18px;border-left:2px solid color-mix(in srgb,var(--accent) 58%,transparent);
  color:var(--text-soft);background:color-mix(in srgb,var(--surface-soft) 70%,transparent);font-style:italic
}
.inner.strong{color:var(--text);font-style:normal}
.pov{
  margin:75px 0 58px;padding:26px 20px;border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);text-align:center
}
.pov small{display:block;color:var(--muted);font:900 10px var(--sans);letter-spacing:.18em}
.pov strong{display:block;margin-top:7px;color:var(--reo);font-size:.9em;letter-spacing:.08em}

.memory-card{
  margin:2.7em 0;padding:24px 20px;border:1px solid var(--line);border-radius:20px;
  background:linear-gradient(145deg,color-mix(in srgb,var(--surface-soft) 80%,transparent),var(--surface))
}
.memory-card .memory-label{margin:0 0 13px;color:var(--accent);font:900 10px var(--sans);letter-spacing:.16em}
.memory-card p{margin:0 0 1em}
.memory-card p:last-child{margin-bottom:0}

.ending{
  margin:105px 0 30px;padding:70px 24px 45px;text-align:center;border:1px solid var(--line);
  border-radius:34px;background:linear-gradient(150deg,var(--surface),var(--surface-soft));box-shadow:var(--shadow)
}
.ending-mark{margin-bottom:28px;color:var(--muted);letter-spacing:.45em}
.ending h2{margin:0;color:var(--accent);font:900 11px var(--sans);letter-spacing:.22em}
.ending-title{margin:12px 0 0;font:600 clamp(1.6rem,7vw,2.25rem)/1.55 var(--serif);letter-spacing:.07em}
.ending-copy{max-width:32rem;margin:33px auto 0;font-size:14px;line-height:2.2}
.next-label{margin-top:46px;color:var(--muted);font:900 10px var(--sans);letter-spacing:.2em}
.next-title{margin:8px 0 20px;font-family:var(--serif)}
.ending-actions{display:grid;gap:10px;width:min(100%,370px);margin:auto}
.primary,.secondary{
  display:flex;align-items:center;justify-content:center;min-height:53px;padding:12px 18px;
  border-radius:999px;text-decoration:none;font:800 13px var(--sans)
}
.primary{color:#fff;background:linear-gradient(135deg,var(--accent),var(--accent-deep));box-shadow:0 10px 25px color-mix(in srgb,var(--accent) 25%,transparent)}
.secondary{color:var(--text-soft);border:1px solid var(--line);background:var(--surface)}
footer{padding:28px 0 8px;color:var(--muted);text-align:center;font-size:10px;line-height:1.9}
footer a{text-underline-offset:3px}

@media(max-width:899px){
  .layout{display:block;padding-top:12px}
  .toc{display:none}
  .current-scene{display:block}
  .reader-bar-inner{align-items:flex-start}
  .tool-btn,.tool-select{min-height:36px;font-size:10px}
  .page{padding-left:15px;padding-right:15px}
  .hero{margin-top:14px;padding:49px 21px 41px}
  .scene{margin-bottom:68px}
}
@media(min-width:700px){
  .ending-actions{grid-template-columns:1fr 1fr;width:min(100%,540px)}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
